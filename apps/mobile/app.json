{
  "expo": {
    "name": "Swallet",
    "slug": "swallet",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "aco-swalet",
    "ios": {
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "NSCameraUsageDescription": "We need access to your camera to scan QR codes.",
        "NSFaceIDUsageDescription": "We use Face ID to unlock your wallet securely.",
        "CFBundleLocalizations": [
          "en",
          "ru"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.aco.swallet",
      "appleTeamId": "9N49283836"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aco.swallet"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ru"
            ],
            "android": [
              "en",
              "ru"
            ]
          }
        }
      ],
      "react-native-bottom-tabs",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2987418a-1c20-4389-9796-485f4e37c78a"
      }
    },
    "owner": "acom"
  }
}
