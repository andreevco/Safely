{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "types": ["node", "vite/client"],
        /* restates the root list plus ESNext.Disposable: `using` in main needs `Symbol.dispose`,
           and lib cannot be extended, only replaced */
        "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"]
    },
    "include": [
        "src/**/*",
        "forge.env.d.ts",
        "forge.config.ts",
        "vite.main.config.ts",
        "vite.preload.config.ts",
        "vite.renderer.config.ts"
    ],
    "exclude": ["node_modules", ".vite", "out"]
}
